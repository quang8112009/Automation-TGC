# AutoTGC Backend — environment template. NEVER commit a real .env.
# Copy to .env and fill values from the secret store / vault.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Process role (perf split). The API and background work run as SEPARATE PM2
# processes so heavy queue/cron/AI work never blocks the API event loop.
#   all    = API + workers + cron in one process (default; single-process/dev).
#   api    = HTTP API only (no workers, no cron).
#   worker = BullMQ workers + cron only (no HTTP listener).
# PM2 (deploy/pm2.config.js) injects RUN_MODE=api / worker per app, overriding
# this value. Leave empty (=all) for local/dev single-process runs.
RUN_MODE=

# Prisma connection pool size PER PROCESS. Because api + worker are separate
# processes, total Postgres connections ≈ (api + worker) × this. Keep the sum
# safely under Postgres max_connections. Appended to DATABASE_URL as
# ?connection_limit=. Empty = Prisma default (num_physical_cpus*2 + 1).
DB_CONNECTION_LIMIT=10

# Database (PostgreSQL 16). NOTE: production runs Postgres on a non-standard
# port 5434 (not 5432) — match your actual instance.
DATABASE_URL=postgresql://autotgc:CHANGE_ME@127.0.0.1:5434/autotgc?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT signing
JWT_SECRET=CHANGE_ME_LONG_RANDOM
ACCESS_TOKEN_TTL_HOURS=24
REFRESH_TOKEN_TTL_DAYS=30

# Auth / lockout
LOCKOUT_THRESHOLD=5
# Auto-recovery window (minutes) for a locked account. After this many minutes a
# locked account auto-unlocks on the next login attempt, so a credential-stuffing
# burst cannot PERMANENTLY lock out an account (incl. the only ADMIN). An explicit
# ADMIN unlock still clears the lock immediately. Set 0 to disable auto-recovery
# (locks then stay until an ADMIN unlocks).
LOCKOUT_COOLDOWN_MINUTES=15

# CORS
FRONTEND_ORIGIN=https://app.example.com

# Trust the fronting proxy (nginx) X-Forwarded-* headers so per-IP rate limiting
# sees the REAL client IP. Default true (production runs behind nginx). Set to
# false ONLY when the app is directly internet-exposed (otherwise clients could
# spoof X-Forwarded-For to evade per-IP throttling).
TRUST_PROXY=true

# Data retention (privacy). The retention-purge job runs daily (CRON_RETENTION_PURGE,
# default '30 3 * * *') and ENFORCES these windows: raw analytics are deleted,
# aged lead/intake PII is anonymized, and stale audit/activity log detail payloads
# are redacted. All values are in MONTHS; omit to use the defaults shown.
#
# SAFETY: the DESTRUCTIVE run is OPT-IN. The job is always registered (and logs a
# skip line) but only deletes/anonymizes data when RETENTION_PURGE_ENABLED is
# truthy ('true'/'1'/'yes'). Leave it empty/false until you've reviewed the
# windows below against production data.
RETENTION_PURGE_ENABLED=
RETENTION_ANALYTICS_MONTHS=12
RETENTION_PII_MONTHS=24
RETENTION_LOG_MONTHS=24
CRON_RETENTION_PURGE=30 3 * * *

# Webhook shared secrets (HMAC). SECURITY: verification fails CLOSED — when a
# secret is empty/unset, that webhook rejects ALL requests (401) rather than
# accepting unsigned payloads. Set a long random value per channel to enable it.
WEBHOOK_SECRET_FACEBOOK=CHANGE_ME
WEBHOOK_SECRET_WEBSITE=CHANGE_ME
# Zalo OA webhook HMAC secret (omni-channel intake). Empty = the Zalo webhook is
# effectively disabled (every request is rejected with 401).
WEBHOOK_SECRET_ZALO=
# Facebook Messenger webhook subscription verify token (GET handshake). Must
# match the token configured in the Meta app webhook settings.
INTAKE_FB_VERIFY_TOKEN=

# Platform tokens (managed; placeholders)
PLATFORM_TOKEN_FACEBOOK=
PLATFORM_TOKEN_TIKTOK=
PLATFORM_TOKEN_TIKTOK_REFRESH=
GA4_PROPERTY_ID=

# Text generation — now targets DeepSeek V4 over the OpenAI-COMPATIBLE gateway
# (e.g. YeScale). DeepSeek V4's API is OpenAI ChatCompletions-compatible, so the
# provider switch is configuration-only (base URL + model + key); no consumer
# code changes. The gateway uses Bearer auth and the client appends
# `/chat/completions` to the base, posting `{model, messages:[...]}` and reading
# `choices[0].message.content`. The GEMINI_* names are retained intentionally
# (operationally stable) even though they now point at DeepSeek.
#
# GEMINI_API_KEY — provider API key. Loaded via the SecretLoader; NEVER logged
#   (only the key NAME is ever logged). Missing key ⇒ AI features fall back to
#   deterministic grounded answers (aiGenerated=false), never a 502 to end users.
GEMINI_API_KEY=
# GEMINI_MODEL — DeepSeek model id. OPTIONAL — defaults to `deepseek-v4-flash`
#   (cheaper/faster, used in production). Alternative: `deepseek-v4-pro` (higher
#   quality). Other valid provider-published ids are accepted as-is.
GEMINI_MODEL=deepseek-v4-flash
# GEMINI_BASE_URL — the gateway's `/v1` base (the client appends
#   `/chat/completions`). Required to call AI; when empty, AI features fall back
#   to deterministic grounded answers.
GEMINI_BASE_URL=
# GEMINI_TIMEOUT_MS — outbound request timeout (ms) for the text gateway.
#   OPTIONAL — defaults to 20000 (20s). NOTE: long-form generation (e.g. an
#   ~800-word SEO article via the Content Studio / multi-format generator) can
#   exceed 20s on DeepSeek V4, which would abort the call and surface
#   AI_REQUEST_FAILED. For production, set this to 90000 (90s) AND raise the
#   nginx `proxy_read_timeout` to at least 120s so the proxy does not cut the
#   request first. Values that are not a finite positive number, or below the
#   100ms floor, are normalized back to the 20000 default.
GEMINI_TIMEOUT_MS=90000

# GEMINI_EMBEDDING_MODEL — OPTIONAL embedding model id (OpenAI-compatible
#   `POST {GEMINI_BASE_URL}/embeddings`). When set ALONGSIDE GEMINI_API_KEY, the
#   grounded assistant uses HYBRID keyword+semantic retrieval and the
#   `POST /api/v1/assistant/knowledge/reindex` (ADMIN) endpoint can cache entry
#   embeddings. Leave BLANK to keep deterministic keyword-only retrieval (the
#   default). Embedding is AI-OPTIONAL: any provider failure degrades to keyword
#   ranking, never an error.
GEMINI_EMBEDDING_MODEL=

# AI media generation providers (image + video) via the OpenAI-COMPATIBLE
# gateway. This block is SEPARATE from and UNAFFECTED by the DeepSeek text
# migration above: DeepSeek does NOT generate images/video, so media keeps its
# own provider, its own keys (GEMINI_IMAGE_* / VEO_*), and its own endpoint
# `POST {base}/images/generations`. The AI text Config_Parser does NOT read any
# of these keys. OPTIONAL — when absent, brand assets stay SPEC_READY
# (render-ready blueprints) and nothing is synthesized. Both modalities call
# `POST {base}/images/generations` with Bearer auth (on the gateway, video is
# served via the SAME images endpoint). Set *_BASE_URL to the gateway `/v1` base.
# Image generation (default model nano-banana-pro):
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_BASE_URL=
# Video generation (default model veo3.1):
VEO_API_KEY=
VEO_MODEL=
VEO_BASE_URL=
# Where rendered asset files are written (defaults to <MEDIA_DIR>/assets):
ASSET_RENDER_DIR=

# Server host (for deploy tooling only; never hardcoded in app logic)
SERVER_HOST=

# Service account credentials (internal, non-interactive). If absent, a random
# credential is generated at seed time (logged by name only).
SERVICE_ACCOUNT_AI_SYSTEM_SECRET=
SERVICE_ACCOUNT_BACKGROUND_WORKER_SECRET=

# Optional cron overrides (defaults: 12h / 6h / every minute / Sun 00:00)
CRON_TOKEN_REFRESH=
CRON_ANALYTICS_COLLECT=
CRON_PUBLISH_SCAN=
CRON_WEEKLY_FEEDBACK=

# Company AI report schedule overrides. OPTIONAL — both have defaults, so the
# app never fails fast on their absence. Each scheduled run only creates a DRAFT
# report (review mode), never auto-APPROVED.
# Weekly company report — default '0 1 * * 1' (Mondays 01:00, the week that just ended):
CRON_WEEKLY_REPORT=
# Monthly company report — default '0 2 1 * *' (1st of month 02:00, the month that just ended):
CRON_MONTHLY_REPORT=

# Study-abroad timeline sweep — proactive idempotent due-item reminders.
# OPTIONAL — defaults to '*/30 * * * *' (every 30 minutes) when unset.
CRON_TIMELINE_SWEEP=*/30 * * * *

# ── AI marketing autopilot (OPT-IN scheduled jobs) ───────────────────────────
# These jobs do real, possibly-costly AI work, so they are OFF by default and
# only RUN when their enable flag below is truthy ('true' / '1' / 'yes'). When a
# flag is empty/false the job is not even registered. They respect REVIEW MODE:
# auto-content-plan creates DRAFT plans only — a human still reviews/activates
# and triggers generation; nothing is auto-published.
#
# Enable flags (default OFF):
AUTOPILOT_AUTO_RESEARCH=
AUTOPILOT_AUTO_PLAN=
AUTOPILOT_ASSET_RETRY=
# Markets the research/plan jobs iterate (comma list of canonical market codes:
# JAPAN,KOREA,GERMANY,TAIWAN,AUSTRALIA,LITHUANIA,EUROPE,DOMESTIC,OTHER). Invalid
# entries are dropped; empty falls back to JAPAN,KOREA,GERMANY,TAIWAN.
AUTOPILOT_MARKETS=
# Optional channel allow-list for auto-content-plan (comma list, e.g.
# facebook,tiktok,website). Empty = planner's full default channel/format matrix.
AUTOPILOT_CHANNELS=
# Oldest-first batch size for asset-render-retry per tick (default 5):
ASSET_RETRY_BATCH=
# Optional cron overrides for the autopilot jobs (defaults: Mon 02:00 / Mon 03:00
# / every 15 minutes):
CRON_AUTO_RESEARCH=
CRON_AUTO_PLAN=
CRON_ASSET_RETRY=

# Optional: Custom CMS API base URL and media storage dir
CMS_BASE_URL=
MEDIA_DIR=
