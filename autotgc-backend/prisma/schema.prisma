// AutoTGC Phase 1 data model (Foundation + Content Pipeline + Analytics + Leads/Dashboard).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
}

enum ContentStatus {
  DRAFT
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  REJECTED
  FAILED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

enum InsightStatus {
  NEW
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model UserAccount {
  id               String         @id @default(uuid())
  username         String         @unique
  email            String
  passwordHash     String
  role             Role           @default(ADMIN)
  failedLoginCount Int            @default(0)
  locked           Boolean        @default(false)
  lockedAt         DateTime?
  // Time-boxed lockout (security): when set and in the future, login is refused
  // (423) but auto-recovers once the instant passes — so a credential-stuffing
  // burst against an account (incl. the only ADMIN) cannot permanently DoS it.
  // An explicit ADMIN unlock still clears `locked` immediately regardless.
  lockedUntil      DateTime?
  createdAt        DateTime       @default(now())
  sessions         JwtSession[]
  assignedLeads    Lead[]
  notifications    Notification[] @relation("UserNotifications")
  assistantConversations AssistantConversation[]
}

model JwtSession {
  sessionId        String      @id @default(uuid())
  userId           String
  user             UserAccount @relation(fields: [userId], references: [id])
  status           String      @default("ACTIVE") // ACTIVE | REVOKED
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime
  createdAt        DateTime    @default(now())
  revokedAt        DateTime?

  @@index([userId])
}

model PlatformToken {
  id                       String    @id @default(uuid())
  platform                 String    @unique
  type                     String // access_token | refresh_token | api_key | service_account
  expiresAt                DateTime?
  refreshWindowSeconds     Int       @default(86400)
  status                   String    @default("VALID")
  lastRefreshFailureReason String?
  updatedAt                DateTime  @updatedAt
}

model DomainContext {
  id                 String           @id @default(uuid())
  domainName         String           @unique
  contextDescription String           @default("")
  defaultToneOfVoice String           @default("friendly")
  createdAt          DateTime         @default(now())
  personas           ContentPersona[]
  drafts             ContentDraft[]
}

model ContentPersona {
  id              String         @id @default(uuid())
  domainId        String
  domain          DomainContext  @relation(fields: [domainId], references: [id])
  personaName     String
  age             String
  interests       String         @default("")
  targetNeeds     String
  painPoints      String
  toneOfVoice     String
  recommendedTone String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  drafts          ContentDraft[]
}

model ContentDraft {
  id                       String           @id @default(uuid())
  domainId                 String
  domain                   DomainContext    @relation(fields: [domainId], references: [id])
  personaId                String
  persona                  ContentPersona   @relation(fields: [personaId], references: [id])
  objective                String
  title                    String
  body                     String
  status                   ContentStatus    @default(DRAFT)
  generatedWithoutFeedback Boolean          @default(false)
  rejectionReason          String?
  previewPresented         Boolean          @default(false)
  // --- AI marketing autopilot (additive; safe defaults keep existing flow intact) ---
  format                   String           @default("GENERIC") // GENERIC|SEO_ARTICLE|FANPAGE_CAPTION|VIDEO_SCRIPT|EMAIL|CARE_MESSAGE|CHATBOT_FAQ
  market                   String? // market code: JAPAN|KOREA|GERMANY|TAIWAN|AUSTRALIA|LITHUANIA|EUROPE|...
  language                 String           @default("vi")
  planItemId               String?
  seoKeywords              Json             @default("[]")
  // Approval_Queue manual priority ordering (additive; default keeps deadline-based order)
  priorityIndex            Int              @default(0)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  ctas                     DraftCta[]
  media                    MediaAsset[]
  scheduledPosts           ScheduledPost[]
  generatedAssets          GeneratedAsset[]

  @@index([createdAt])
  @@index([status])
}

model DraftCta {
  id      String       @id @default(uuid())
  draftId String
  draft   ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  ctaText String
}

model MediaAsset {
  id         String       @id @default(uuid())
  draftId    String
  draft      ContentDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  kind       String // image | video | photo_carousel
  storageKey String
  mimeType   String
  createdAt  DateTime     @default(now())
}

model ScheduledPost {
  id             String        @id @default(uuid())
  draftId        String
  draft          ContentDraft  @relation(fields: [draftId], references: [id])
  platform       String
  scheduledAt    DateTime
  status         ContentStatus @default(SCHEDULED)
  idempotencyKey String        @unique
  externalPostId String?
  postUrl        String?
  errorCode      String?
  failureReason  String?
  retryCount     Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([platform, idempotencyKey])
  @@index([status, scheduledAt])
}

model AnalyticsRecord {
  id              String   @id @default(uuid())
  publishedPostId String
  platform        String
  views           Int?
  likes           Int?
  shares          Int?
  comments        Int?
  follows         Int?
  leads           Int?
  clickThrough    Int?
  reach           Int?
  collectedAt     DateTime @default(now())

  @@index([publishedPostId, collectedAt])
}

model PerformanceRecord {
  id               String   @id @default(uuid())
  postId           String
  domainCategory   String
  contentTopic     String
  personaId        String
  toneOfVoice      String
  objective        String
  platform         String
  postTimeSlot     String
  contentLength    Int
  hasCta           Boolean
  ctaType          String
  mediaType        String
  conversionRate   Float
  engagementRate   Float
  ctaClickRate     Float
  followRate       Float?
  performanceLabel String
  scoredAt         DateTime @default(now())

  @@index([scoredAt])
  @@index([contentTopic, scoredAt])
}

model LearningInsight {
  id                String        @id @default(uuid())
  insightType       String
  insightStatus     InsightStatus @default(NEW)
  subject           Json
  metrics           Json
  recommendedChange Json
  modifiedChange    Json?
  confidenceScore   Float
  sampleSize        Int
  analysisPeriod    String
  rejectionReason   String?
  generatedAt       DateTime      @default(now())
  // Approval_Queue manual priority ordering (additive; default keeps deadline-based order)
  priorityIndex     Int           @default(0)

  @@index([insightStatus, generatedAt])
}

model AiPromptContext {
  id                       String    @id @default(uuid())
  contextVersion           String
  lastUpdatedFromAnalytics DateTime?
  topPerformingTopics      Json
  bestCtaPatterns          Json
  avoidTopics              Json
  optimalContentLength     Json
  toneRecommendations      Json
  optimalSchedules         Json
}

model AuditEntry {
  id         String   @id @default(uuid())
  eventType  String
  insightId  String
  actor      String
  detail     Json
  recordedAt DateTime @default(now())
}

model Lead {
  leadId         String             @id @default(uuid())
  name           String?
  phone          String?
  email          String?
  source         String
  platform       String
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  contentPostId  String
  domainCategory String?
  contentTopic   String?
  status         LeadStatus         @default(NEW)
  note           String?
  assignedTo     String?
  assignee       UserAccount?       @relation(fields: [assignedTo], references: [id])
  unattributed   Boolean            @default(false)
  // Webhook idempotency (security): a stable per-delivery key (provider event id
  // or HMAC of the canonical payload). A unique index makes a replayed webhook
  // delivery a no-op (upsert) instead of creating duplicate Lead rows.
  dedupKey       String?            @unique
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  history        LeadHistoryEntry[]

  @@index([source])
  @@index([platform])
  @@index([status])
  @@index([createdAt])
  @@index([contentPostId])
  @@index([domainCategory, contentTopic])
  @@index([assignedTo])
}

model LeadHistoryEntry {
  id             String   @id @default(uuid())
  leadId         String
  lead           Lead     @relation(fields: [leadId], references: [leadId], onDelete: Cascade)
  previousStatus String
  newStatus      String
  note           String?
  assignedTo     String?
  actor          String
  changedAt      DateTime @default(now())
}

model TokenAlert {
  id       String   @id @default(uuid())
  platform String
  kind     String
  reason   String?
  raisedAt DateTime @default(now())
}

// --- Service accounts (Foundation Req 8): non-interactive internal identities ---
model ServiceAccount {
  id             String              @id @default(uuid())
  name           String              @unique // 'ai-system' | 'background-worker'
  credentialHash String
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  permissions    ServicePermission[]
}

model ServicePermission {
  id               String         @id @default(uuid())
  serviceAccountId String
  serviceAccount   ServiceAccount @relation(fields: [serviceAccountId], references: [id], onDelete: Cascade)
  module           String
  action           String

  @@unique([serviceAccountId, module, action])
}

// --- Lead assignment lookup (Foundation Req 6.3, 6.7): SALES assigned-lead checks ---
model LeadAssignment {
  id         String   @id @default(uuid())
  leadId     String   @unique
  userId     String
  assignedAt DateTime @default(now())

  @@index([userId])
}

// --- Agentic orchestration state (State Management) ---
// A WorkflowRun tracks a multi-step agentic pipeline (e.g. generate -> review ->
// schedule -> publish) as a persisted saga with per-step status + context.
enum WorkflowStatus {
  PENDING
  RUNNING
  WAITING_APPROVAL
  COMPLETED
  FAILED
  CANCELLED
}

model WorkflowRun {
  id          String         @id @default(uuid())
  type        String // e.g. 'content_pipeline'
  status      WorkflowStatus @default(PENDING)
  currentStep String?
  context     Json // accumulated inputs/outputs across steps
  error       String?
  createdBy   String? // user id or service account name
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  steps       WorkflowStep[]

  @@index([status])
  @@index([type])
}

model WorkflowStep {
  id         String      @id @default(uuid())
  runId      String
  run        WorkflowRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  name       String
  status     String      @default("PENDING") // PENDING | RUNNING | DONE | FAILED | SKIPPED
  input      Json?
  output     Json?
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  orderIndex Int

  @@index([runId])
}

// ===========================================================================
// Recruitment CRM (labor-export / XKLĐ) — additive domain for Thanh Giang.
//
// Adapts the platform from a generic marketing-lead CRM into a labor-export
// candidate CRM: JobOrder (đơn hàng tuyển dụng), CandidateProfile (ứng viên)
// with a recruitment pipeline state machine, Branch (chi nhánh), and a
// KnowledgeEntry store used to ground the AI recruitment-consultant agent.
// All models are additive; the existing Lead remains the raw inbound contact
// and a Lead may be promoted into a CandidateProfile (lead -> candidate).
// ===========================================================================

enum RecruitmentMarket {
  JAPAN
  GERMANY
  KOREA
  TAIWAN
  DOMESTIC
  OTHER
}

enum VisaType {
  TOKUTEI // Kỹ năng đặc định (SSW)
  ENGINEER // Kỹ sư - Nhân viên
  TRAINEE // Thực tập sinh (TTS)
  STUDENT // Du học / Sinh viên thực tập
  GERMANY_PROGRAM // XKLĐ Đức
  KOREA_EPS // Hàn Quốc (EPS)
  DOMESTIC_JOB // Việc làm trong nước
  OTHER
}

enum JobOrderStatus {
  OPEN
  PAUSED
  CLOSED
  FILLED
}

enum CandidateStage {
  NEW
  CONSULTING
  PROFILE_COLLECTED
  MATCHED
  INTERVIEW_SCHEDULED
  INTERVIEW_PASSED
  COE_VISA
  DEPARTED
  WITHDRAWN
  REJECTED
}

model Branch {
  id         String             @id @default(uuid())
  code       String             @unique
  name       String
  city       String             @default("")
  address    String             @default("")
  phone      String             @default("")
  createdAt  DateTime           @default(now())
  candidates CandidateProfile[]
  jobOrders  JobOrder[]
}

model JobOrder {
  id             String             @id @default(uuid())
  code           String             @unique // e.g. KN6131
  title          String
  industry       String             @default("") // nghề: Xây dựng, Điều dưỡng, ...
  visaType       VisaType           @default(TOKUTEI)
  market         RecruitmentMarket  @default(JAPAN)
  workLocation   String             @default("") // prefecture / region
  salaryText     String             @default("") // display, e.g. "42-57tr"
  salaryMinVndM  Int? // million VND (optional, for filtering)
  salaryMaxVndM  Int?
  quantity       Int                @default(1)
  gender         String             @default("ANY") // MALE | FEMALE | ANY
  nationalityReq String             @default("")
  status         JobOrderStatus     @default(OPEN)
  deadline       DateTime?
  description    String             @default("")
  sourcePostId   String? // link to a published ScheduledPost/content when applicable
  branchId       String?
  branch         Branch?            @relation(fields: [branchId], references: [id])
  assignedTo     String? // consultant userId được giao đơn hàng này (assigned-only scope for SALES)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  candidates     CandidateProfile[]

  @@index([market])
  @@index([visaType])
  @@index([industry])
  @@index([status])
  @@index([code])
  @@index([assignedTo])
}

model CandidateProfile {
  id                String                  @id @default(uuid())
  leadId            String?                 @unique // links to the originating Lead contact when present
  fullName          String
  phone             String?
  email             String?
  dob               DateTime?
  gender            String                  @default("") // MALE | FEMALE | ""
  hometown          String                  @default("")
  education         String                  @default("")
  currentJob        String                  @default("")
  desiredMarket     RecruitmentMarket?
  desiredIndustry   String                  @default("")
  desiredVisaType   VisaType?
  japaneseLevel     String                  @default("NONE") // NONE | N5 | N4 | N3 | N2 | N1
  otherLanguage     String                  @default("")
  stage             CandidateStage          @default(NEW)
  matchedJobOrderId String?
  matchedJobOrder   JobOrder?               @relation(fields: [matchedJobOrderId], references: [id])
  branchId          String?
  branch            Branch?                 @relation(fields: [branchId], references: [id])
  assignedTo        String? // consultant userId
  note              String?
  source            String                  @default("")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  history           CandidateStageHistory[]
  documents         DocumentChecklistItem[]
  // --- Study-abroad AI advisor suite (additive back-relations; existing columns untouched) ---
  academic          AcademicProfile?
  essays            EssayDraft[]
  interviews        InterviewSession[]
  applications      ApplicationCase[]
  roadmaps          RoadmapNarrative[]

  @@index([stage])
  @@index([desiredMarket])
  @@index([assignedTo])
  @@index([matchedJobOrderId])
  @@index([branchId])
}

model CandidateStageHistory {
  id            String           @id @default(uuid())
  candidateId   String
  candidate     CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  previousStage String
  newStage      String
  note          String?
  actor         String
  changedAt     DateTime         @default(now())
}

// Knowledge base used to ground the AI recruitment-consultant agent. Each entry
// is a small piece of company/market/visa/industry/FAQ context the agent
// retrieves to produce relevant XKLĐ content and consulting answers.
model KnowledgeEntry {
  id        String   @id @default(uuid())
  category  String // company | market | visa | industry | faq | process | branch
  title     String
  content   String
  tags      Json     @default("[]")
  market    String?
  active    Boolean  @default(true)
  // Cached embedding vector (number[]) for semantic (cosine) retrieval. NULL
  // until an ADMIN reindex computes it; absent it, retrieval degrades to the
  // deterministic keyword/tag ranking. Never contains secrets.
  embedding Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([active])
}

// ===========================================================================
// Assistant conversational memory (additive). Persists multi-turn grounded-
// assistant threads so the agent carries short-term context across turns. A
// conversation is PRIVATE to exactly one UserAccount; the route layer enforces
// owner-only access (there is no cross-user read, not even for ADMIN).
// ===========================================================================

enum AssistantRole {
  USER
  ASSISTANT
}

model AssistantConversation {
  id        String             @id @default(uuid())
  userId    String // owner (UserAccount.id); private to this user
  user      UserAccount        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String? // optional human label (derived from the first question)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AssistantMessage[]

  // Composite (userId, updatedAt): the list query is `where userId order by
  // updatedAt desc`, so this index serves the filter AND the sort in one shot
  // (and still covers userId-only lookups via the prefix).
  @@index([userId, updatedAt])
}

model AssistantMessage {
  id             String                @id @default(uuid())
  conversationId String
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AssistantRole
  content        String
  // True ONLY for ASSISTANT messages produced by the AI provider (never for a
  // deterministic fallback) — mirrors the AI-OPTIONAL `aiGenerated` flag.
  aiGenerated    Boolean               @default(false)
  createdAt      DateTime              @default(now())

  // Composite (conversationId, createdAt): history reads filter by conversation
  // and order by createdAt, so this lets Postgres satisfy both without a sort.
  @@index([conversationId, createdAt])
}

// ===========================================================================
// AI Marketing Autopilot (additive) — trend research, market content planning,
// multi-format generation, brand-template visual/video asset generation, and
// the autopilot orchestration that ties research -> plan -> generate -> review
// -> schedule -> publish -> measure -> optimize into a data-driven loop.
//
// Design principle (per product goal): NOT "post a lot", but produce
// high-performance content that drives traffic / follows / leads. The planner
// and generators consume the analytics AiPromptContext so output is biased
// toward what actually performs.
// ===========================================================================

enum TrendStatus {
  DISCOVERED
  REVIEWED
  ADOPTED
  DISMISSED
}

// A researched market trend / keyword / high-demand topic. Produced by the
// TrendResearchService (AI + heuristics) and reviewed before driving a plan.
model TrendSignal {
  id           String      @id @default(uuid())
  market       String // JAPAN|KOREA|GERMANY|TAIWAN|AUSTRALIA|LITHUANIA|EUROPE|...
  keyword      String
  topic        String      @default("")
  intent       String      @default("") // e.g. salary | visa | industry | cost | eligibility
  demandScore  Float       @default(0) // 0..100 estimated demand/interest
  rationale    String      @default("")
  sources      Json        @default("[]")
  status       TrendStatus @default(DISCOVERED)
  discoveredAt DateTime    @default(now())

  @@index([market])
  @@index([status])
  @@index([keyword])
}

enum ContentPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// A per-market content plan (kế hoạch nội dung) for a date range, produced by
// the ContentPlanner from trends + analytics context.
model ContentPlan {
  id         String            @id @default(uuid())
  market     String
  title      String
  objective  String            @default("Lead") // Lead|View|Follow
  periodFrom DateTime
  periodTo   DateTime
  status     ContentPlanStatus @default(DRAFT)
  notes      String            @default("")
  createdBy  String?
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
  items      ContentPlanItem[]

  @@index([market])
  @@index([status])
}

// One scheduled idea inside a plan: which format, channel, topic, target date.
model ContentPlanItem {
  id         String      @id @default(uuid())
  planId     String
  plan       ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  market     String
  channel    String // facebook|tiktok|youtube|website|zalo|email
  format     String // SEO_ARTICLE|FANPAGE_CAPTION|VIDEO_SCRIPT|EMAIL|CARE_MESSAGE|CHATBOT_FAQ
  topic      String
  keyword    String      @default("")
  objective  String      @default("Lead")
  targetDate DateTime?
  status     String      @default("PLANNED") // PLANNED|GENERATED|SCHEDULED|PUBLISHED|SKIPPED
  draftId    String?
  trendId    String?
  orderIndex Int         @default(0)
  createdAt  DateTime    @default(now())

  @@index([planId])
  @@index([status])
}

// A generated visual/video asset (thumbnail, infographic, poster, short video)
// produced from a brand template. When an image/video generation provider is
// configured it holds the produced file's storage key; otherwise it holds a
// deterministic render SPEC (brand template + resolved copy) so production is
// not blocked and a human/designer or a later provider can render it.
model GeneratedAsset {
  id         String        @id @default(uuid())
  draftId    String?
  draft      ContentDraft? @relation(fields: [draftId], references: [id], onDelete: SetNull)
  kind       String // thumbnail|infographic|poster|short_video|image
  templateId String?
  prompt     String        @default("")
  spec       Json          @default("{}") // resolved brand-template render spec
  status     String        @default("SPEC_READY") // SPEC_READY|RENDERING|RENDERED|FAILED
  storageKey String? // set when actually rendered by a provider
  mimeType   String?
  provider   String        @default("none")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([draftId])
  @@index([kind])
  @@index([status])
}

// Brand template definitions (thương hiệu) used to render visual assets
// consistently: palette, fonts, logo placement, layout per asset kind.
model BrandTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  kind      String // thumbnail|infographic|poster|short_video
  spec      Json     @default("{}") // colors, fonts, logo, layout slots
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([active])
}

// ===========================================================================
// AI Reporting & Ops Enhancements (additive) — company WEEKLY/MONTHLY AI
// reports, candidate document checklists, and a configurable default document
// catalog per recruitment market. All models/enums below are additive and do
// not modify existing models/fields.
// ===========================================================================

enum ReportType {
  WEEKLY
  MONTHLY
}

enum ReportStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
  INSUFFICIENT_DATA
}

enum DocSubmissionStatus {
  PENDING
  SUBMITTED
  VERIFIED
  REJECTED
}

enum DocSource {
  DEFAULT
  CUSTOM
}

// AI-generated company report for a WEEKLY/MONTHLY period. Created in DRAFT
// (review mode) or INSUFFICIENT_DATA when no valid records exist; transitions
// are guarded by Report_State_Machine.
model CompanyReport {
  id          String       @id @default(uuid())
  reportType  ReportType
  periodFrom  DateTime
  periodTo    DateTime
  periodLabel String // e.g. "2024-W23" | "2024-06"
  status      ReportStatus @default(DRAFT)
  content     Json // serialized ReportContent
  aiGenerated Boolean      @default(false)
  scopeUserId String? // null = company-wide scope (ADMIN)
  createdBy   String? // userId | 'background-worker'
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([reportType, periodLabel, scopeUserId])
  @@index([reportType, periodFrom])
  @@index([status])
}

// A single document-checklist item attached to a candidate. Cascade-deleted
// with its CandidateProfile.
model DocumentChecklistItem {
  id          String              @id @default(uuid())
  candidateId String
  candidate   CandidateProfile    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  type        String // stable document-type code (e.g. PASSPORT, HEALTH_CHECK)
  label       String // display label
  status      DocSubmissionStatus @default(PENDING)
  required    Boolean             @default(true)
  source      DocSource           @default(DEFAULT)
  note        String?
  submittedAt DateTime? // set when status moves to SUBMITTED
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ADMIN-configurable default document set per recruitment market. Editing the
// catalog does not affect already-created DocumentChecklistItem rows.
model DocumentTypeCatalog {
  id        String   @id @default(uuid())
  market    String   @unique // RecruitmentMarket code: JAPAN|KOREA|GERMANY|TAIWAN|DOMESTIC|OTHER
  docs      Json     @default("[]") // DocTypeDef[]: { type, label, required }
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// ===========================================================================
// Admin Oversight, RBAC & Notifications (additive) — persistent per-recipient
// notifications and an append-only, multi-entity activity log. Both models are
// additive and do not modify existing models/fields (including AuditEntry).
// ===========================================================================

/// Thông báo bền vững gắn một người nhận (Req 1). Additive.
model Notification {
  id              String      @id @default(uuid())
  recipientUserId String // FK -> UserAccount.id (Req 1.2)
  recipient       UserAccount @relation("UserNotifications", fields: [recipientUserId], references: [id], onDelete: Cascade)
  kind            String // 'ACTIVITY' | ... (Req 1.1)
  message         String
  refType         String? // loại thực thể nguồn (tùy chọn) — Req 1.6
  refId           String? // id thực thể nguồn (tùy chọn) — Req 1.6
  read            Boolean     @default(false) // mặc định chưa đọc — Req 1.3
  createdAt       DateTime    @default(now())

  @@index([recipientUserId, createdAt]) // truy vấn theo người nhận + thời gian (Req 1.4)
  @@index([read])
}

/// Nhật ký hoạt động đa thực thể, append-only (Req 2). Additive, độc lập AuditEntry.
model ActivityLog {
  id          String   @id @default(uuid())
  actorUserId String // người thực hiện (Req 2.1, 6.6)
  action      String // loại hành động / eventType
  targetType  String // loại thực thể đích
  targetId    String // định danh thực thể đích
  detail      Json     @default("{}") // lưu verbatim (Req 2.6)
  createdAt   DateTime @default(now()) // server đóng dấu (Req 2.4)

  @@index([actorUserId]) // Req 2.3
  @@index([targetType, targetId]) // Req 2.3
  @@index([createdAt]) // Req 2.3
}

// ===========================================================================
// Omni-channel Intake + Partners/Destinations + Visa & Logistics (additive).
//
// Three additive subsystems for the labor-export (XKLĐ) / study-abroad flow:
//  1. Conversational Intake — a chatbot over Facebook Messenger + Zalo OA that
//     asks dossier questions, collects structured answers, and lands them in the
//     central system (linked to a Lead / CandidateProfile).
//  2. Partners & Destinations — cooperating organizations (đối tác đã hợp tác)
//     and export/study destination programs with explicit eligibility conditions
//     the matching agent evaluates.
//  3. Visa & Logistics — per-country smart visa checklists with deadlines, plus
//     a logistics plan (flight / insurance e.g. OSHC / airport pickup / housing).
// All models/enums below are additive and do not modify existing ones.
// ===========================================================================

enum IntakeChannel {
  FACEBOOK
  ZALO
  WEBSITE
}

enum IntakeStatus {
  ACTIVE // bot is collecting answers
  COMPLETED // all required fields collected
  HANDED_OFF // escalated to a human consultant
  ABANDONED // inactive / closed without completion
}

enum IntakeDirection {
  INBOUND
  OUTBOUND
}

// A per-contact conversation on a messaging channel. Holds the collected dossier
// answers as JSON and the current question pointer for the intake flow engine.
model IntakeConversation {
  id              String          @id @default(uuid())
  channel         IntakeChannel
  externalUserId  String // platform-scoped sender id (PSID / Zalo user id)
  displayName     String?
  flowKey         String          @default("xkld_default")
  status          IntakeStatus    @default(ACTIVE)
  currentFieldKey String? // the field the bot is currently awaiting
  collected       Json            @default("{}") // { fieldKey: value } structured answers
  leadId          String? // linked Lead once created
  candidateId     String? // linked CandidateProfile once promoted
  assignedTo      String? // consultant userId after hand-off
  lastInboundAt   DateTime?
  lastOutboundAt  DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  messages        IntakeMessage[]

  @@unique([channel, externalUserId])
  @@index([status])
  @@index([candidateId])
  @@index([leadId])
}

// Append-only message log for a conversation (both directions).
model IntakeMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   IntakeConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction      IntakeDirection
  text           String
  fieldKey       String? // which dossier field this message targeted (outbound prompt / inbound answer)
  raw            Json? // raw platform payload (non-secret)
  createdAt      DateTime           @default(now())

  @@index([conversationId])
}

enum PartnerType {
  EMPLOYER // chủ sử dụng lao động / nghiệp đoàn
  SCHOOL // trường / cơ sở đào tạo
  BROKER // đối tác môi giới
  SERVICE // dịch vụ (đưa đón, bảo hiểm, nhà ở...)
}

enum PartnerStatus {
  ACTIVE
  PAUSED
  ENDED
}

// A cooperating organization (đối tác đã hợp tác).
model PartnerOrg {
  id          String               @id @default(uuid())
  name        String
  type        PartnerType          @default(EMPLOYER)
  country     String               @default("") // market/country code (free-form, see markets.ts)
  contactName String               @default("")
  phone       String               @default("")
  email       String               @default("")
  status      PartnerStatus        @default(ACTIVE)
  notes       String               @default("")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  programs    DestinationProgram[]

  @@index([type])
  @@index([country])
  @@index([status])
}

enum DestinationStatus {
  OPEN
  PAUSED
  CLOSED
}

// An export/study destination program with explicit eligibility conditions the
// matching agent evaluates against a candidate's profile.
model DestinationProgram {
  id                    String            @id @default(uuid())
  name                  String
  country               String // market/country code (JAPAN|KOREA|GERMANY|TAIWAN|AUSTRALIA|...)
  visaType              String            @default("") // free-form visa/program type
  partnerId             String?
  partner               PartnerOrg?       @relation(fields: [partnerId], references: [id])
  minAge                Int?
  maxAge                Int?
  gender                String            @default("ANY") // ANY | MALE | FEMALE
  requiredLanguage      String            @default("") // e.g. "japanese" | "english" | ""
  minLanguageLevel      String            @default("") // e.g. N4 | IELTS5.5 | ""
  budgetMinVndM         Int? // estimated cost floor (million VND)
  budgetMaxVndM         Int?
  // --- Study-abroad financial fields (scholarship matching; additive) ---
  tuitionPerYearVndM    Int? // học phí / năm (triệu VND)
  livingCostPerYearVndM Int? // sinh hoạt phí / năm (triệu VND)
  scholarshipMaxPct     Int? // % học bổng tối đa có thể đạt (0..100)
  minGpa                Float? // GPA tối thiểu (thang 10) để xét học bổng
  minIelts              Float? // IELTS tối thiểu để xét học bổng
  // --- Study-abroad admissions thresholds (additive nullable; missing → no constraint on that axis) ---
  minToefl              Int? // bổ sung nullable; thiếu → không ràng buộc chiều TOEFL
  minJlpt               String? // bổ sung nullable; N5..N1
  selectivityTier       String? // HIGH | MEDIUM | LOW; thiếu → coi như MEDIUM khi phân band
  industries            Json              @default("[]") // string[]
  conditions            Json              @default("[]") // free-form extra condition strings (shown to agent)
  status                DestinationStatus @default(OPEN)
  notes                 String            @default("")
  active                Boolean           @default(true)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@index([country])
  @@index([status])
  @@index([active])
}

enum VisaCaseStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum VisaTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  BLOCKED
}

// A per-candidate visa case for a destination country, with a smart checklist of
// tasks (documents + logistics) and key deadlines.
model VisaCase {
  id                 String         @id @default(uuid())
  candidateId        String
  country            String // AUSTRALIA | USA | CANADA | UK | JAPAN | KOREA | GERMANY | TAIWAN | ...
  visaType           String         @default("")
  status             VisaCaseStatus @default(OPEN)
  targetIntakeDate   DateTime? // mong muốn nhập học / xuất cảnh
  submissionDeadline DateTime? // hạn nộp hồ sơ
  aiGenerated        Boolean        @default(false)
  notes              String         @default("")
  createdBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  tasks              VisaTask[]
  logistics          LogisticsPlan?

  @@index([candidateId])
  @@index([country])
  @@index([status])
  @@index([submissionDeadline])
}

enum VisaTaskCategory {
  DOCUMENT
  INSURANCE
  FLIGHT
  HOUSING
  PICKUP
  FEE
  OTHER
}

// A single checklist item within a visa case.
model VisaTask {
  id        String           @id @default(uuid())
  caseId    String
  case      VisaCase         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  code      String // stable task code (e.g. PASSPORT, OSHC, FLIGHT_BOOKING)
  label     String
  category  VisaTaskCategory @default(DOCUMENT)
  required  Boolean          @default(true)
  status    VisaTaskStatus   @default(PENDING)
  dueAt     DateTime?
  note      String?
  source    String           @default("DEFAULT") // DEFAULT | CUSTOM
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([caseId])
  @@index([status])
  @@index([dueAt])
}

// Logistics plan attached to a visa case: flight, insurance (e.g. OSHC), airport
// pickup, and housing (homestay / dormitory) suggestions + bookings.
model LogisticsPlan {
  id            String   @id @default(uuid())
  caseId        String   @unique
  case          VisaCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  flightInfo    Json? // { airline?, flightNo?, departAt?, arriveAt?, from?, to? }
  insuranceType String   @default("") // e.g. OSHC | TRAVEL | NONE
  insuranceInfo Json? // { provider?, policyNo?, coverFrom?, coverTo? }
  pickupService String   @default("") // partner/service name
  pickupInfo    Json? // { provider?, pickupAt?, location? }
  housingType   String   @default("") // HOMESTAY | DORMITORY | RENTAL | NONE
  housingInfo   Json? // { provider?, address?, moveInAt? }
  aiGenerated   Boolean  @default(false)
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ===========================================================================
// Study-abroad enhancements (additive): Financial & Scholarship matching, and
// Behavior-based follow-up nurturing.
//   1. DestinationProgram financial fields (above, via ALTER in migration) feed
//      the pure scholarship matcher.
//   2. FollowUpTask — queued personalized nurture messages for drop-off contacts.
// All additive; no existing model/field is modified destructively.
// ===========================================================================

enum FollowUpStatus {
  PENDING // scheduled, not yet sent
  SENT // delivered (or attempted) to the channel
  SKIPPED // contact re-engaged before the due time
  CANCELLED // manually cancelled / no longer relevant
}

// A queued, behavior-based nurture follow-up for a drop-off contact. A
// background agent fills the message and the scheduler/worker sends it.
model FollowUpTask {
  id             String         @id @default(uuid())
  conversationId String? // soft ref to IntakeConversation.id
  candidateId    String?
  leadId         String?
  channel        String // FACEBOOK | ZALO | WEBSITE
  externalUserId String
  reason         String         @default("") // e.g. drop_off_after_inquiry
  topic          String         @default("") // last-known interest (e.g. "ĐH Tokyo")
  message        String         @default("")
  status         FollowUpStatus @default(PENDING)
  dueAt          DateTime
  sentAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status, dueAt])
  @@index([conversationId])
  @@index([externalUserId])
}

// ===========================================================================
// Study-abroad AI advisor suite (additive) — admissions scoring + Reach/Match/
// Safety banding, SOP/Essay/CV writing & review, visa interview prep, proactive
// application timeline, and study→career→PR roadmap (ROI) + readiness.
//
// All models/enums below are additive and do not modify existing models/fields.
// EssayStatus is reused by RoadmapNarrative (same REVIEW MODE lifecycle) to
// avoid duplicating the enum.
// ===========================================================================

enum EssayDocType {
  SOP
  MOTIVATION
  CV
}

enum EssayStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  ARCHIVED
}

enum ApplicationStatus {
  PLANNING // đang chuẩn bị hồ sơ
  SUBMITTED // đã nộp hồ sơ trường
  OFFER // nhận offer
  VISA // chuyển sang giai đoạn visa
  ENROLLED // đã nhập học
  WITHDRAWN
  REJECTED
}

// Academic signals for admissions scoring — 1–1 with CandidateProfile. Cascade-
// deleted with its CandidateProfile. All measurement fields nullable so missing
// data is treated as INSUFFICIENT_DATA rather than fabricated.
model AcademicProfile {
  id             String           @id @default(uuid())
  candidateId    String           @unique // 1–1 (Req 1.1)
  candidate      CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  gpa            Float? // thang gpaScale
  gpaScale       Float? // ví dụ 10 hoặc 4.0 (điều kiện tiên quyết chuẩn hóa > 0)
  ielts          Float? // 0..9
  toefl          Int? // 0..120
  jlpt           String? // N5..N1
  educationLevel String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([candidateId])
}

// A SOP / motivation letter / CV draft for a candidate. REVIEW MODE: always
// created DRAFT and transitioned via the guarded Essay_State_Machine.
model EssayDraft {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade) // Req 9.1, cascade
  docType     EssayDocType // Req 6.1, 6.6
  programId   String? // chương trình mục tiêu (tùy chọn)
  content     String // nội dung bản nháp
  aiGenerated Boolean          @default(false) // Req 20.1
  status      EssayStatus      @default(DRAFT) // Req 6.5
  approvedBy  String? // Req 8.4
  approvedAt  DateTime? // Req 8.4
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([candidateId])
  @@index([status])
}

// A visa interview-prep session for a candidate. Snapshots candidate.assignedTo
// at creation time for stable SALES assigned-only RBAC.
model InterviewSession {
  id                 String           @id @default(uuid())
  candidateId        String
  candidate          CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade) // Req 12.2
  country            String
  visaType           String           @default("")
  questions          Json             @default("[]") // InterviewQuestion[]
  answers            Json             @default("{}") // { questionCode: answer }
  feedback           Json             @default("{}") // { questionCode: feedback }
  score              Float? // ∈ [0,1] khi có
  assignedAtCreation String? // snapshot candidate.assignedTo lúc TẠO (Req 12.3)
  aiGenerated        Boolean          @default(false) // Req 20.1
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([candidateId])
}

// A program application case for a candidate with its own due-item checklist.
// Timeline_Computer merges ApplicationDueItem with VisaTask across all cases.
model ApplicationCase {
  id               String               @id @default(uuid())
  candidateId      String
  candidate        CandidateProfile     @relation(fields: [candidateId], references: [id], onDelete: Cascade) // Req 13.2
  programId        String? // gắn DestinationProgram (Req 13.1)
  intakeLabel      String // ví dụ "Fall 2025"
  targetIntakeDate DateTime? // null → due-item hạn chưa xác định (Req 13.4)
  status           ApplicationStatus    @default(PLANNING)
  visaCaseId       String? // soft link tới VisaCase (Req 13.2)
  createdBy        String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  dueItems         ApplicationDueItem[]

  @@index([candidateId])
  @@index([status])
}

model ApplicationDueItem {
  id        String          @id @default(uuid())
  caseId    String
  case      ApplicationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  code      String // mã việc (từ visaCatalog hoặc CUSTOM)
  label     String
  category  String          @default("DOCUMENT") // VisaTaskCategory-compatible
  required  Boolean         @default(true)
  dueAt     DateTime? // null = hạn chưa xác định (Req 13.4)
  status    String          @default("PENDING") // PENDING|IN_PROGRESS|DONE|BLOCKED
  done      Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([caseId])
  @@index([dueAt])
}

// Dedup ledger making reminder creation idempotent at the DB level: each
// Due_Item gets exactly one Reminder per reminder window while pending.
model ReminderLog {
  id             String   @id @default(uuid())
  dueItemId      String // id ApplicationDueItem | VisaTask
  dueItemType    String   @default("APPLICATION") // APPLICATION | VISA
  windowKey      String // khóa cửa sổ nhắc xác định (ví dụ "2025-08-01")
  status         String   @default("PENDING") // PENDING | RESOLVED | CANCELLED (Req 15.2, 15.3)
  notificationId String? // Notification đã tạo (nếu có)
  createdAt      DateTime @default(now())

  @@unique([dueItemId, windowKey]) // ràng buộc lũy đẳng (Req 15.2, 15.4)
  @@index([status])
}

// A study→career→PR roadmap narrative (ROI estimate + human-readable text).
// REVIEW MODE: reuses EssayStatus lifecycle so all narratives are approved
// before being treated as official.
model RoadmapNarrative {
  id          String           @id @default(uuid())
  candidateId String
  candidate   CandidateProfile @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  programId   String?
  estimate    Json // RoadmapEstimate đã serialize
  narrative   String // bản tường thuật
  aiGenerated Boolean          @default(false) // Req 20.1
  status      EssayStatus      @default(DRAFT) // REVIEW MODE (Req 17.3)
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([candidateId])
  @@index([status])
}

// ===========================================================================
// Privacy, consent & webhook-replay protection (additive, security hardening).
//
// Three additive models close gaps surfaced in a security review:
//  1. WebhookDelivery — a replay ledger. Every accepted inbound webhook records
//     its (source, deliveryId) so a re-POSTed payload (captured signature) is
//     rejected as a duplicate even though the HMAC still verifies.
//  2. ConsentRecord — an append-only consent ledger for a data subject (lead /
//     candidate / intake contact), including explicit cross-border AI-transfer
//     consent. Withdrawals are new rows (never updates) so history is preserved.
//  3. ErasureRequest — a right-to-erasure (GDPR Art.17 style) request + its
//     processing outcome, so PII deletion is auditable.
// None modify existing models/fields.
// ===========================================================================

/// Inbound webhook replay ledger. (source, deliveryId) is unique so a replayed
/// delivery (same captured signature + body) is detected and rejected.
model WebhookDelivery {
  id          String   @id @default(uuid())
  source      String // 'lead:facebook' | 'lead:website' | 'intake:facebook' | 'intake:zalo'
  deliveryId  String // provider delivery/event id, or a content hash fallback
  signature   String? // truncated signature fingerprint (NOT the secret) for forensics
  receivedAt  DateTime @default(now())

  @@unique([source, deliveryId])
  @@index([receivedAt])
}

enum ConsentSubjectType {
  LEAD
  CANDIDATE
  INTAKE
}

enum ConsentScope {
  DATA_PROCESSING // store + process personal data for consulting
  MARKETING // send marketing / follow-up messages
  CROSS_BORDER_AI // transfer content to overseas AI providers (DeepSeek/Gemini/VEO)
}

enum ConsentAction {
  GRANTED
  WITHDRAWN
}

/// Append-only consent ledger. A withdrawal is a NEW row (action=WITHDRAWN), so
/// the effective consent for a (subject, scope) is the most recent row.
model ConsentRecord {
  id          String             @id @default(uuid())
  subjectType ConsentSubjectType
  subjectId   String // Lead.leadId | CandidateProfile.id | IntakeConversation.id
  scope       ConsentScope
  action      ConsentAction      @default(GRANTED)
  source      String             @default("") // how consent was captured (form/webhook/chat)
  note        String?
  actor       String             @default("system") // userId or 'system'/'self'
  recordedAt  DateTime           @default(now())

  @@index([subjectType, subjectId])
  @@index([scope])
  @@index([recordedAt])
}

enum ErasureStatus {
  REQUESTED
  COMPLETED
  REJECTED
}

/// Right-to-erasure request + outcome (auditable PII deletion).
model ErasureRequest {
  id           String        @id @default(uuid())
  subjectType  ConsentSubjectType
  subjectId    String
  status       ErasureStatus @default(REQUESTED)
  reason       String        @default("")
  requestedBy  String // userId who lodged the request
  processedBy  String? // userId who executed it
  // Summary of what was erased (counts only — NEVER the erased PII values).
  erasedSummary Json         @default("{}")
  requestedAt  DateTime      @default(now())
  processedAt  DateTime?

  @@index([subjectType, subjectId])
  @@index([status])
}
