# AutoTGC Backend — environment template. NEVER commit a real .env.
# Copy to .env and fill values from the secret store / vault.

NODE_ENV=production
PORT=3000
HOST=127.0.0.1

# Process role (perf split). The API and background work run as SEPARATE PM2
# processes so heavy queue/cron/AI work never blocks the API event loop.
#   all    = API + workers + cron in one process (default; single-process/dev).
#   api    = HTTP API only (no workers, no cron).
#   worker = BullMQ workers + cron only (no HTTP listener).
# PM2 (deploy/pm2.config.js) injects RUN_MODE=api / worker per app, overriding
# this value. Leave empty (=all) for local/dev single-process runs.
RUN_MODE=

# Prisma connection pool size PER PROCESS. Because api + worker are separate
# processes, total Postgres connections ≈ (api + worker) × this. Keep the sum
# safely under Postgres max_connections. Appended to DATABASE_URL as
# ?connection_limit=. Empty = Prisma default (num_physical_cpus*2 + 1).
DB_CONNECTION_LIMIT=10

# Database (PostgreSQL 16). NOTE: production runs Postgres on a non-standard
# port 5434 (not 5432) — match your actual instance.
DATABASE_URL=postgresql://autotgc:CHANGE_ME@127.0.0.1:5434/autotgc?schema=public

# Redis
REDIS_URL=redis://127.0.0.1:6379

# JWT signing. SECURITY: must be at least 32 characters of high-entropy random
# (startup FAILS FAST if shorter). Generate with `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_LONG_RANDOM_AT_LEAST_32_CHARS
# Access token lifetime (hours). Default 1 (giờ); có thể đặt 0.5 (30 phút).
# Giá trị được clamp về khoảng 0.25–24; input không hợp lệ → mặc định 1. Rút
# ngắn TTL để giảm cửa sổ khai thác của một access token bị rò rỉ.
ACCESS_TOKEN_TTL_HOURS=1
# Refresh tokens now ROTATE on every /api/auth/refresh (the presenting token's
# session is revoked and a new pair issued), so a leaked refresh token is usable
# only until the next legitimate refresh. Replaying a rotated token returns 401.
REFRESH_TOKEN_TTL_DAYS=30

# Auth / lockout
LOCKOUT_THRESHOLD=5
# Auto-recovery window (minutes) for a locked account. After this many minutes a
# locked account auto-unlocks on the next login attempt, so a credential-stuffing
# burst cannot PERMANENTLY lock out an account (incl. the only ADMIN). An explicit
# ADMIN unlock still clears the lock immediately. Set 0 to disable auto-recovery
# (locks then stay until an ADMIN unlocks).
LOCKOUT_COOLDOWN_MINUTES=15

# CORS
FRONTEND_ORIGIN=https://app.example.com

# Trust the fronting proxy (nginx) X-Forwarded-* headers so per-IP rate limiting
# sees the REAL client IP. Default true (production runs behind nginx). Set to
# false ONLY when the app is directly internet-exposed (otherwise clients could
# spoof X-Forwarded-For to evade per-IP throttling).
TRUST_PROXY=true

# Data retention (privacy). The retention-purge job runs daily (CRON_RETENTION_PURGE,
# default '30 3 * * *') and ENFORCES these windows: raw analytics are deleted,
# aged lead/intake PII is anonymized, and stale audit/activity log detail payloads
# are redacted. All values are in MONTHS; omit to use the defaults shown.
#
# SAFETY: the DESTRUCTIVE run is OPT-IN. The job is always registered (and logs a
# skip line) but only deletes/anonymizes data when RETENTION_PURGE_ENABLED is
# truthy ('true'/'1'/'yes'). Leave it empty/false until you've reviewed the
# windows below against production data.
RETENTION_PURGE_ENABLED=
RETENTION_ANALYTICS_MONTHS=12
RETENTION_PII_MONTHS=24
RETENTION_LOG_MONTHS=24
CRON_RETENTION_PURGE=30 3 * * *

# Webhook shared secrets (HMAC). SECURITY: verification fails CLOSED — when a
# secret is empty/unset, that webhook rejects ALL requests (401) rather than
# accepting unsigned payloads. Set a long random value per channel to enable it.
WEBHOOK_SECRET_FACEBOOK=CHANGE_ME
WEBHOOK_SECRET_WEBSITE=CHANGE_ME
# Zalo OA webhook HMAC secret (omni-channel intake). Empty = the Zalo webhook is
# effectively disabled (every request is rejected with 401).
WEBHOOK_SECRET_ZALO=
# Facebook Messenger webhook subscription verify token (GET handshake). Must
# match the token configured in the Meta app webhook settings.
INTAKE_FB_VERIFY_TOKEN=

# Platform tokens (managed; placeholders)
PLATFORM_TOKEN_FACEBOOK=
PLATFORM_TOKEN_TIKTOK=
PLATFORM_TOKEN_TIKTOK_REFRESH=
GA4_PROPERTY_ID=

# Text generation — now targets DeepSeek V4 over the OpenAI-COMPATIBLE gateway
# (e.g. YeScale). DeepSeek V4's API is OpenAI ChatCompletions-compatible, so the
# provider switch is configuration-only (base URL + model + key); no consumer
# code changes. The gateway uses Bearer auth and the client appends
# `/chat/completions` to the base, posting `{model, messages:[...]}` and reading
# `choices[0].message.content`. The GEMINI_* names are retained intentionally
# (operationally stable) even though they now point at DeepSeek.
#
# GEMINI_API_KEY — provider API key. Loaded via the SecretLoader; NEVER logged
#   (only the key NAME is ever logged). Missing key ⇒ AI features fall back to
#   deterministic grounded answers (aiGenerated=false), never a 502 to end users.
GEMINI_API_KEY=
# GEMINI_MODEL — DeepSeek model id. OPTIONAL — defaults to `deepseek-v4-flash`
#   (cheaper/faster, used in production). Alternative: `deepseek-v4-pro` (higher
#   quality). Other valid provider-published ids are accepted as-is.
GEMINI_MODEL=deepseek-v4-flash
# GEMINI_BASE_URL — the gateway's `/v1` base (the client appends
#   `/chat/completions`). Required to call AI; when empty, AI features fall back
#   to deterministic grounded answers.
GEMINI_BASE_URL=
# GEMINI_TIMEOUT_MS — outbound request timeout (ms) for the text gateway.
#   OPTIONAL — defaults to 20000 (20s). NOTE: long-form generation (e.g. an
#   ~800-word SEO article via the Content Studio / multi-format generator) can
#   exceed 20s on DeepSeek V4, which would abort the call and surface
#   AI_REQUEST_FAILED. For production, set this to 90000 (90s) AND raise the
#   nginx `proxy_read_timeout` to at least 120s so the proxy does not cut the
#   request first. Values that are not a finite positive number, or below the
#   100ms floor, are normalized back to the 20000 default.
GEMINI_TIMEOUT_MS=90000

# GEMINI_MAX_TOKENS — OPTIONAL default cap on output tokens (max_tokens) applied
#   to every text-generation call that does NOT pass its own per-call maxTokens.
#   A WORST-CASE guard on generation length + latency (and provider cost): it
#   bounds runaway/over-verbose responses and trims tail latency (p95/p99).
#   Leave BLANK to disable (historic uncapped behaviour — no max_tokens sent).
#   Choose generously so normal content is never truncated: ~2048 fits an
#   ~800-1000 word draft; raise it if long-form essays/roadmaps get cut off.
#   An explicit per-call maxTokens always overrides this default. Non-positive
#   or non-numeric values are treated as "unset" (no cap). Recommended: 2048.
GEMINI_MAX_TOKENS=

# GEMINI_EMBEDDING_MODEL — OPTIONAL embedding model id (OpenAI-compatible
#   `POST {GEMINI_BASE_URL}/embeddings`). When set ALONGSIDE GEMINI_API_KEY, the
#   grounded assistant uses HYBRID keyword+semantic retrieval and the
#   `POST /api/v1/assistant/knowledge/reindex` (ADMIN) endpoint can cache entry
#   embeddings. Leave BLANK to keep deterministic keyword-only retrieval (the
#   default). Embedding is AI-OPTIONAL: any provider failure degrades to keyword
#   ranking, never an error.
GEMINI_EMBEDDING_MODEL=

# ═════════════════════════════════════════════════════════════════════════════
# AI IMAGE GENERATION — DiT (Diffusion Transformer) + fallback
# ═════════════════════════════════════════════════════════════════════════════
# DiT models (FLUX.1, Stable Diffusion 3) are the STATE-OF-THE-ART for text-
# to-image generation, replacing U-Net backbones with scalable transformer
# architectures. Key advantages for our brand assets:
#   1. SUPERIOR TEXT RENDERING — Vietnamese headlines, CTAs, footers render
#      legibly (critical for XKLĐ brand assets)
#   2. BETTER PROMPT ADHERENCE — MMDiT architecture separates text/image
#      weights while fusing them in attention
#   3. GLOBAL CONTEXT — self-attention captures long-range dependencies
#   4. SCALABLE — performance improves predictably with model size
#
# PRIORITY: DiT (REPLICATE_API_TOKEN) > OpenAI-compat (GEMINI_IMAGE_API_KEY)
# When both are configured, DiT wins. OpenAI-compat is kept as fallback.
# When NEITHER is configured, assets stay SPEC_READY (blueprint-only).
# ─────────────────────────────────────────────────────────────────────────────

# DiT image generation via Replicate API (PREFERRED):
#   Get your token at https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
#   Model slug. Options:
#     black-forest-labs/flux-schnell  — 1-4 steps, fastest (default)
#     black-forest-labs/flux-dev      — higher quality, guidance-distilled
#     black-forest-labs/flux-pro      — best quality, API-only
#     stability-ai/stable-diffusion-3 — SD3 with MMDiT architecture
DIT_MODEL=black-forest-labs/flux-schnell
#   Inference steps (default: 4 for schnell, 20 for dev/pro):
DIT_NUM_STEPS=
#   Classifier-free guidance scale (default: 0 for schnell, 3.5 for dev):
DIT_GUIDANCE_SCALE=
#   Fixed seed for deterministic generation (random if omitted).
#   Use the same seed to reproduce identical outputs for QA/A-B testing.
#   Valid range: 0–2147483647. Empty = random seed per render.
DIT_SEED=
#   Output format for rendered images:
#     png  — lossless, highest quality (default; best for posters)
#     jpeg — lossy, smaller files (good for thumbnails)
#     webp — compressed, modern format (best compression ratio)
DIT_OUTPUT_FORMAT=png
#   Per-request timeout in milliseconds for Replicate API calls.
#   Prevents hanging on slow/unresponsive API. Default: 30000 (30s).
#   Increase if using slow models (e.g. flux-pro with many steps).
DIT_TIMEOUT_MS=30000
#   Negative prompt for guidance models (FLUX.1 dev/pro, SD3).
#   Only effective when DIT_MODEL is NOT schnell (schnell uses guidance-distilled
#   architecture where negative prompts have minimal impact).
#   Example: 'blurry, ugly, deformed text, misspelled, watermarks'
#   Empty = no negative prompt sent.
DIT_NEGATIVE_PROMPT=

# Fallback: OpenAI-compatible image generation (YeScale gateway):
#   When REPLICATE_API_TOKEN is empty, this provider is used instead.
GEMINI_IMAGE_API_KEY=
GEMINI_IMAGE_MODEL=
GEMINI_IMAGE_BASE_URL=

# Video generation (unchanged — YeScale gateway, default model veo3.1):
VEO_API_KEY=
VEO_MODEL=
VEO_BASE_URL=
# Where rendered asset files are written (defaults to <MEDIA_DIR>/assets):
ASSET_RENDER_DIR=

# Server host (for deploy tooling only; never hardcoded in app logic)
SERVER_HOST=

# Service account credentials (internal, non-interactive). If absent, a random
# credential is generated at seed time (logged by name only).
SERVICE_ACCOUNT_AI_SYSTEM_SECRET=
SERVICE_ACCOUNT_BACKGROUND_WORKER_SECRET=

# Optional cron overrides (defaults: 12h / 6h / every minute / Sun 00:00)
CRON_TOKEN_REFRESH=
CRON_ANALYTICS_COLLECT=
CRON_PUBLISH_SCAN=
CRON_WEEKLY_FEEDBACK=

# Company AI report schedule overrides. OPTIONAL — both have defaults, so the
# app never fails fast on their absence. Each scheduled run only creates a DRAFT
# report (review mode), never auto-APPROVED.
# Weekly company report — default '0 1 * * 1' (Mondays 01:00, the week that just ended):
CRON_WEEKLY_REPORT=
# Monthly company report — default '0 2 1 * *' (1st of month 02:00, the month that just ended):
CRON_MONTHLY_REPORT=

# Study-abroad timeline sweep — proactive idempotent due-item reminders.
# OPTIONAL — defaults to '*/30 * * * *' (every 30 minutes) when unset.
CRON_TIMELINE_SWEEP=*/30 * * * *

# ── AI marketing autopilot (OPT-IN scheduled jobs) ───────────────────────────
# These jobs do real, possibly-costly AI work, so they are OFF by default and
# only RUN when their enable flag below is truthy ('true' / '1' / 'yes'). When a
# flag is empty/false the job is not even registered. They respect REVIEW MODE:
# auto-content-plan creates DRAFT plans only — a human still reviews/activates
# and triggers generation; nothing is auto-published.
#
# Enable flags (default OFF):
AUTOPILOT_AUTO_RESEARCH=
AUTOPILOT_AUTO_PLAN=
AUTOPILOT_ASSET_RETRY=
# Markets the research/plan jobs iterate (comma list of canonical market codes:
# JAPAN,KOREA,GERMANY,TAIWAN,AUSTRALIA,LITHUANIA,EUROPE,DOMESTIC,OTHER). Invalid
# entries are dropped; empty falls back to JAPAN,KOREA,GERMANY,TAIWAN.
AUTOPILOT_MARKETS=
# Optional channel allow-list for auto-content-plan (comma list, e.g.
# facebook,tiktok,website). Empty = planner's full default channel/format matrix.
AUTOPILOT_CHANNELS=
# Oldest-first batch size for asset-render-retry per tick (default 5):
ASSET_RETRY_BATCH=
# Optional cron overrides for the autopilot jobs (defaults: Mon 02:00 / Mon 03:00
# / every 15 minutes):
CRON_AUTO_RESEARCH=
CRON_AUTO_PLAN=
CRON_ASSET_RETRY=

# Optional: Custom CMS API base URL and media storage dir
CMS_BASE_URL=
MEDIA_DIR=

# ═════════════════════════════════════════════════════════════════════════════
# Production hardening (observability, alerting, durability, TLS, quota, tracing)
# ─────────────────────────────────────────────────────────────────────────────
# EVERY key below is OPTIONAL and loaded via SecretLoader.optional(). When a key
# is empty the related capability DEGRADES SAFELY: the app still starts and
# serves traffic, the feature simply turns itself off (no crash, no 502, no
# fail-fast). Set only the keys for capabilities you want to enable. The inline
# notes describe exactly what an empty value does.
# ═════════════════════════════════════════════════════════════════════════════

# --- Observability: Metrics (R1) ---
# Bearer token a Prometheus scraper must present at GET /metrics. SECURITY: the
# route is only registered when this token is set — empty METRICS_SCRAPE_TOKEN
# means /metrics returns 404 (feature off). When set, the endpoint is public
# (bypasses JWT) but guarded by a constant-time compare of this token: missing
# credential → 401, wrong token → 403, correct → 200 text exposition.
METRICS_SCRAPE_TOKEN=

# --- Observability: Error tracking (R2) ---
# Sentry DSN for forwarding true server errors (500/502 and non-AppError). Empty
# SENTRY_DSN => errors are not forwarded (a no-op tracker is used); 4xx client
# errors are NEVER forwarded regardless. SENTRY_ENVIRONMENT tags events (e.g.
# 'production'); empty just leaves the environment tag unset.
SENTRY_DSN=
SENTRY_ENVIRONMENT=

# --- Out-of-band alerting + incident classifier (R3) ---
# Webhook (e.g. Slack/Telegram relay) for delivering incident alerts off-box.
# Empty ALERT_WEBHOOK_URL => incidents are still persisted as TokenAlert rows
# (platform='SYSTEM') but nothing is sent out-of-band. Thresholds below tune the
# incident classifier; each is clamped to a safe range with the default shown.
ALERT_WEBHOOK_URL=
# Suppress duplicate deliveries of the same incident within this many minutes (default 30).
ALERT_DEDUP_WINDOW_MINUTES=30
# Worker heartbeat older than this many seconds is treated as a WORKER_DOWN incident (default 120).
ALERT_HEARTBEAT_TIMEOUT_SECONDS=120
# Consecutive job failures that trip a JOB_FAILURES incident (default 5).
ALERT_JOB_FAILURE_THRESHOLD=5
# Queue backlog (pending jobs) that trips a QUEUE_BACKLOG incident (default 1000).
ALERT_QUEUE_BACKLOG_THRESHOLD=1000
# AI fallback rate (%) over the window below that trips an AI_DEGRADED incident (default 20).
ALERT_AI_FALLBACK_RATE_PERCENT=20
# Rolling window (minutes) used to compute the AI fallback rate (default 15).
ALERT_AI_FALLBACK_WINDOW_MINUTES=15
# How often the incident monitor cron samples signals, in seconds; ≤60 keeps detection→delivery under 60s (default 45).
INCIDENT_MONITOR_INTERVAL_SECONDS=45

# --- Worker heartbeat (R4) ---
# How often the Worker_Process writes its liveness timestamp to Redis (default 10s).
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
# Max heartbeat age before GET /healthz/worker reports 503 unhealthy (default 30s).
WORKER_HEARTBEAT_STALENESS_SECONDS=30

# --- AI cost-control / per-user quota (R5) ---
# Rolling counting window for per-user AI usage, in seconds (default 86400 = 24h).
AI_QUOTA_WINDOW_SECONDS=86400
# Per-user request limits per window, by role. EMPTY limit => that role has NO
# AI quota cap (only the per-IP rate limits apply). Set a positive integer to cap.
AI_QUOTA_LIMIT_ADMIN=
AI_QUOTA_LIMIT_SALES=
AI_QUOTA_LIMIT_DEFAULT=
# Emit an AI_QUOTA_WARNING incident once a user reaches this % of their limit (default 80).
AI_QUOTA_WARN_PERCENT=80

# --- HTTPS/TLS termination (R7) ---
# Deploy-level only (consumed by nginx + certbot in deploy/, not app logic).
# Empty PROD_DOMAIN => nginx keeps serving the plain :80 proxy block (no TLS,
# no HTTPS redirect). When set, deploy provisions a cert for this domain and
# enables the :443 server + HSTS. CERTBOT_EMAIL is used for Let's Encrypt
# registration / expiry notices.
PROD_DOMAIN=
CERTBOT_EMAIL=

# --- Automated, offsite, verified backups (R8) ---
# NOTE: BACKUP_DIR / BACKUP_RETENTION_DAYS / BACKUP_OFFSITE_DIR are configured
# elsewhere (deploy backup tooling) and already exist. The keys below extend it.
# Minimum number of most-recent backups to always keep, even past retention (default 7).
BACKUP_MIN_KEEP=7
# Target interval between backups, in hours (default 24).
BACKUP_INTERVAL_HOURS=24
# Enable periodic restore-verification of the latest backup. Empty/false => the
# verify job logs a skip line and does NOT exercise a restore (truthy to enable).
BACKUP_VERIFY_ENABLED=
# Max days between successful backup verifications (cadence target, default 7).
BACKUP_VERIFY_CADENCE_DAYS=7

# --- Distributed tracing: OpenTelemetry (R11) ---
# OTLP/HTTP collector endpoint for trace spans. Empty OTEL_EXPORTER_OTLP_ENDPOINT
# => tracing is disabled: no spans are created or exported and nothing fails.
# When set, the NodeSDK auto-instruments Fastify/ioredis/pg and exports spans.
# OTEL_SERVICE_NAME labels the service in your tracing backend (default autotgc-backend).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=autotgc-backend
