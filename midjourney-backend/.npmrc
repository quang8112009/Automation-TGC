# Security-hardened npm configuration for AutoTGC backend.
# Enforces lockfile integrity, blocks scripts on install, and disables telemetry.

# Always use lockfile — prevent "phantom installs" where npm resolves fresh
# dependencies ignoring package-lock.json. This is critical for reproducible
# builds and CI determinism.
package-lock=true

# Block lifecycle scripts during `npm install` in CI to prevent supply-chain
# attacks (malicious postinstall hooks). Locally, override with --ignore-scripts=false.
ignore-scripts=true

# Disable npm telemetry (no data leaves the machine).
fund=false
audit=true

# Enforce strict peer dependency resolution.
legacy-peer-deps=false

# Prefer offline installs when cache is available.
prefer-offline=false

# Pin Node engine to prevent accidental use of unsupported versions.
engine-strict=true
